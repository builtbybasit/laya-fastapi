# Copy to .env and run: uv run --env-file .env main.py
# All values are optional; defaults shown.

# mlx on Apple Silicon, torch elsewhere
# LAYA_BACKEND=torch

# Hugging Face repo or local path (default: aac6fef/laya-mlx for mlx, convaiinnovations/laya for torch)
# LAYA_MODEL=convaiinnovations/laya

# auto when unset; e.g. cuda, cuda:1, cpu, mps
# LAYA_DEVICE=cuda

LAYA_HOST=127.0.0.1
LAYA_PORT=8000
LAYA_LOG_LEVEL=info

# Only needed for private/gated Hugging Face models
# HF_TOKEN=
